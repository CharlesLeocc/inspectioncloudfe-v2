{
  "name": "inspectioncloudfe-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run tokens:validate",
    "dev": "vite",
    "prebuild": "npm run tokens:validate",
    "build": "vite build",
    "preview": "vite preview",
    "tokens:sync": "node scripts/sync-design-tokens.cjs",
    "tokens:validate": "node scripts/sync-design-tokens.cjs --check",
    "tokens:color-map": "node scripts/generate-color-map.cjs",
    "lint:style": "stylelint \"src/**/*.{css,less,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,less,vue}\" --fix",
    "lint:script": "eslint .",
    "lint:script:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@riebo/nova": "^0.0.5",
    "@unocss/preset-attributify": "^66.7.5",
    "element-plus": "^2.14.3",
    "less": "^4.6.7",
    "three": "0.184.0",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.1.1"
  },
  "lint-staged": {
    "*.{js,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
